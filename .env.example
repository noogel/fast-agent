# 仅作参考：程序不自动加载此文件，请通过 export 设置环境变量。
FAST_AGENT_API_KEY=your-api-key
FAST_AGENT_BASE_URL=https://api.openai.com/v1
FAST_AGENT_MODEL=your-tool-capable-model

# 模型网络策略：重试次数不包括初次请求；读取超时不是整个任务总时长。
FAST_AGENT_CONNECT_TIMEOUT=10
FAST_AGENT_READ_TIMEOUT=60
FAST_AGENT_MAX_RETRIES=2

# 进程内模型请求预算（含摘要和重试），0 表示不限；不是金额或账户级配额。
FAST_AGENT_MAX_REQUESTS=0
